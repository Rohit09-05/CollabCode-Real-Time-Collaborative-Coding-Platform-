# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── MySQL ─────────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=collabcode
DB_USER=collabcode_user
DB_PASSWORD=CollabCode@2024
# Set to true for Railway / PlanetScale / any cloud MySQL
DB_SSL=false

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate strong secrets: openssl rand -hex 64
JWT_ACCESS_SECRET=REPLACE_WITH_STRONG_SECRET_64_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_SECRET_64_CHARS
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Judge0 Code Execution ─────────────────────────────────────────────────────
# Sign up at https://rapidapi.com/judge0-official/api/judge0-ce
# Leave blank to use mock execution (dev mode)
JUDGE0_API_KEY=
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_HOST=judge0-ce.p.rapidapi.com

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
